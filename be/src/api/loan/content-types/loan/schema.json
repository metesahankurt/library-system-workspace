{
  "kind": "collectionType",
  "collectionName": "loans",
  "info": {
    "singularName": "loan",
    "pluralName": "loans",
    "displayName": "Loan",
    "description": "Book loans (checkouts)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "book": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::book.book",
      "inversedBy": "loans"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "reservation": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::reservation.reservation",
      "inversedBy": "loan"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "returned", "overdue", "lost"],
      "default": "active",
      "required": true
    },
    "loanedAt": {
      "type": "datetime",
      "required": true
    },
    "dueDate": {
      "type": "datetime",
      "required": true
    },
    "returnedAt": {
      "type": "datetime"
    },
    "notes": {
      "type": "text"
    }
  }
}
